{
  "crons": [
    {
      "path": "/api/admin/campaigns/process",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/admin/health-scores/recalculate",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/admin/automations/confirm-remind/run",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/admin/automations/auto-clean/run",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/admin/automations/smart-tags/run",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/admin/campaigns/recover",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/admin/automations/process",
      "schedule": "0 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/((?!newsletter/|web/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/newsletter/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; img-src 'self' https: data:; style-src 'unsafe-inline'; font-src 'self' https: data:; base-uri 'none'; form-action 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/web/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; img-src 'self' https: data:; style-src 'unsafe-inline'; font-src 'self' https: data:; base-uri 'none'; form-action 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
